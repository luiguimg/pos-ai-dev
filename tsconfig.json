{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "baseUrl": ".",

    "paths": {
      "PosApi/*": [
        "pos-sdk-types/PosApi/*"
      ]
    },

    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": false
  },

  "include": [
    "src",
    "agents",
    "generated-extensions",
    "pos-sdk-types"
  ]
}
